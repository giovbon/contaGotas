package views

templ Cabecalho() {
	<header class="topo">
		<a class="marca" href="/">Reading Drip</a>
		<nav class="acoes">
			<a href="/">Biblioteca</a>
			<a href="/history">Histórico</a>
			<a href="/settings">Configurações</a>
			<form method="post" action="/logout">
				<button class="link" type="submit">Sair</button>
			</form>
		</nav>
	</header>
}

templ rodape() {
	<footer class="rodape">
		<span>Reading Drip</span>
		<span>uma dose de leitura por dia</span>
	</footer>
}
