# Copie para .env e preencha. O .env não vai para o Git.
#
# APP_BASE_URL é a URL pública https do app. APP_SECRET precisa de 32+ bytes
# aleatórios, por exemplo: openssl rand -base64 48
APP_BASE_URL=https://leitura.exemplo.com
APP_PASSWORD=troque-por-uma-senha-forte
APP_SECRET=troque-por-32-bytes-aleatorios-em-base64

# Token do túnel Cloudflare (Zero Trust → Tunnels → configure).
CF_TUNNEL_TOKEN=troque-pelo-token-do-tunel

# Opcionais: imagem/versão usadas por `docker compose` e o fuso do host.
# RD_IMAGE=ghcr.io/seu-usuario/readingdrip:latest
# RD_VERSION=dev
# TZ=America/Sao_Paulo
